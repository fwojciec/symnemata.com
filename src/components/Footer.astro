---
type Props = {
  rightHref?: string
  rightLabel?: string
}

const year = new Date().getFullYear()
const { rightHref, rightLabel } = Astro.props
---

<footer class="foot">
  <div class="left">© <span class="num-tab">{year}</span> · symnēmata.com</div>
  <div class="center">— a co-remembering —</div>
  <div class="right">
    <a href="/about">Methodology</a>{
      rightLabel && rightHref && (
        <Fragment>
          {' · '}
          <a href={rightHref}>{rightLabel}</a>
        </Fragment>
      )
    }
  </div>
</footer>
